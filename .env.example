# Copy to .env.local for local development.

# URL of the NestJS backend. Next.js proxies /api/* and /storage/* to it
# (see next.config.mjs), so the browser only ever talks to this app's origin.
BACKEND_URL=http://localhost:4000

# Optional: call the API directly from the browser instead of via the proxy.
# Leave unset unless you know you need it — the refresh cookie is
# SameSite=Strict and the dashboard guard relies on same-origin cookies.
# NEXT_PUBLIC_API_URL=
